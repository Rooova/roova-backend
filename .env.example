MONGODB_URI="mongodb://localhost:27017/roova"

# Backend listen port — kept off 3000 since the Next.js frontend dev server
# also defaults to 3000 and the two now run side by side locally.
PORT=4000

# Session cookie signing secret — generate a real random value for production.
SESSION_SECRET="dev-secret-change-me"

# Cookie domain — left empty for local dev. Cookies are scoped by domain, not
# port, so a cookie set by localhost:4000 is still sent on same-site requests
# to localhost:3000 under SameSite=Lax with no domain override needed.
COOKIE_DOMAIN=

# Comma-separated list of frontend origins allowed to call this API with credentials.
# Single-origin, path-based frontend (no subdomains) — see roova-web ROADMAP.md.
FRONTEND_ORIGINS="http://localhost:3000"

# Where each role's reset-password page lives, used to build the link sent by MailService.
AGENCY_RESET_PASSWORD_URL="http://localhost:3000/agency/reset-password"
ADMIN_RESET_PASSWORD_URL="http://localhost:3000/admin/reset-password"
INVESTOR_RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# Seed script credentials for the initial admin account.
SEED_ADMIN_EMAIL="admin@roova.xyz"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Paystack (test/sandbox keys for local dev — never commit real live keys).
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Frontend page Paystack redirects back to once checkout completes.
INVESTOR_WALLET_CALLBACK_URL="http://localhost:3000/investor/wallet/callback"
