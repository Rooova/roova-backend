DATABASE_URL="postgresql://roova:roova@localhost:5432/roova?schema=public"

# Session cookie signing secret — generate a real random value for production.
SESSION_SECRET="dev-secret-change-me"

# Cookie domain so the session cookie is shared across subdomains.
# Leave unset for local dev (agency.localhost / admin.localhost work without it).
# Set to ".roova.xyz" in production.
COOKIE_DOMAIN=

# Comma-separated list of frontend origins allowed to call this API with credentials.
FRONTEND_ORIGINS="http://localhost:3000,http://agency.localhost:3000,http://admin.localhost:3000"

# Where each role's reset-password page lives, used to build the link sent by MailService.
AGENCY_RESET_PASSWORD_URL="http://agency.localhost:3000/reset-password"
ADMIN_RESET_PASSWORD_URL="http://admin.localhost:3000/reset-password"
INVESTOR_RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# Seed script credentials for the initial admin account.
SEED_ADMIN_EMAIL="admin@roova.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
